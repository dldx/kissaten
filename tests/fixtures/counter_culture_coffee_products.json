_97663b97-8346-443c-949d-d6c0abe8c4a1.jpg?v=1730830619", "width": 2048, "height": 2048}, {"id": 32060270673997, "created_at": "2024-11-05T13:17:53-05:00", "position": 5, "updated_at": "2024-11-05T13:17:54-05:00", "product_id": 6870662414413, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0249/4283/7837/files/forweb-4904-EditFS1_0e37e1c6-e504-47ce-94c1-9039a886f9f3.jpg?v=1730830674", "width": 2048, "height": 2048}, {"id": 32060275687501, "created_at": "2024-11-05T13:18:52-05:00", "position": 6, "updated_at": "2024-11-05T13:18:54-05:00", "product_id": 6870662414413, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0249/4283/7837/files/forweb-4664-EditHOL1_a1511938-bcde-48a0-a1e1-8f92ca72ff03.jpg?v=1730830734", "width": 2048, "height": 2048}, {"id": 32060277358669, "created_at": "2024-11-05T13:19:08-05:00", "position": 7, "updated_at": "2024-11-05T13:19:10-05:00", "product_id": 6870662414413, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0249/4283/7837/files/forweb-4856-EditGR1_c9d613fb-5e01-4fd8-8109-0537583cf24c.jpg?v=1730830750", "width": 2048, "height": 2048}], "options": [{"name": "Title", "position": 1, "values": ["Default Title"]}]}, {"id": 7041922891853, "title": "Bestseller Bundle", "handle": "bestsellers-bundle", "body_html": "<p><span style=\"font-weight: 400;\">Our Bestseller bundle brings together two of our most beloved coffees. Year after year, Big Trouble and La Golondrina take the top spots for our best-selling year-round blend and best-selling single-origin coffees. Try the classic rich and nutty profiles of Big Trouble and La Golondrina and see why they are favorites among coffee enthusiasts.</span></p>\n<ul>\n<li aria-level=\"1\" style=\"font-weight: 400;\"><span style=\"font-weight: 400;\">Best-Sellers: Big Trouble and La Golondrina are best-selling coffees in their categories, celebrated for their exceptional flavors.</span></li>\n<li aria-level=\"1\" style=\"font-weight: 400;\"><span style=\"font-weight: 400;\">Nutty Notes: Both blends feature delightful nutty undertones, creating a cohesive tasting experience.</span></li>\n<li aria-level=\"1\" style=\"font-weight: 400;\"><span style=\"font-weight: 400;\">Versatile Brewing: Whether enjoyed as an espresso, pour-over, or drip, these coffees cater to every brewing preference.</span></li>\n<li aria-level=\"1\" style=\"font-weight: 400;\"><span style=\"font-weight: 400;\">Bundle and save: Save 25% and explore these fan favorites.</span></li>\n</ul>", "published_at": "2024-11-13T14:40:19-05:00", "created_at": "2024-03-18T23:10:46-04:00", "updated_at": "2026-09-16T12:24:28-04:00", "vendor": "Counter Culture Coffee", "product_type": "Bundle", "tags": ["bestseller", "bundle", "coffee", "gg_coffee_bundles", "gift"], "variants": [{"id": 40590902067277, "title": "Default Title", "option1": "Default Title", "option2": null, "option3": null, "sku": "BUNDLE-2BG", "requires_shipping": true, "taxable": true, "featured_image": null, "available": true, "price": "0.00", "grams": 0, "compare_at_price": null, "position": 2, "product_id": 7041922891853, "created_at": "2024-03-18T23:10:46-04:00", "updated_at": "2026-09-16T12:24:28-04:00"}], "images": [{"id": 34976995639373, "created_at": "2024-03-08T21:53:37-05:00", "position": 1, "updated_at": "2024-03-08T21:53:39-05:00", "product_id": 7041922891853, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0249/4283/7837/files/Best_Sellers.png?v=1709952819", "width": 2084, "height": 2084}], "options": [{"name": "Title", "position": 1, "values": ["Default Title"]}]}, {"id": 6732364546125, "title": "Big Trouble", "handle": "big-trouble", "body_html": "<p><span style=\"font-weight: 400;\">For a coffee called Big Trouble, this blend delivers nutty, caramel, and chocolate flavors that are easy to love. Sourced from sustainable producers across the globe, this medium-dark roast blend is expertly roasted to ensure a consistently exceptional brew every time. Striking the ideal balance between sweet flavors and a satisfying medium body, it\u2019s no wonder Big Trouble is our best-selling blend.</span></p>", "published_at": "2022-03-22T19:50:47-04:00", "created_at": "2022-03-22T12:57:38-04:00", "updated_at": "2026-09-16T12:24:28-04:00", "vendor": "Counter Culture Coffee - Retail", "product_type": "Coffee", "tags": ["bestseller", "coffee", "color__BBE590", "origin__year-round-blend", "recommended", "roastlevel__dark-roast", "roastlevel__medium-dark-roast", "roastlevel__medium-roast", "subscription", "year-round"], "variants": [{"id": 39657673097293, "title": "12 oz", "option1": "12 oz", "option2": null, "option3": null, "sku": "E27-BG", "requires_shipping": true, "taxable": true, "featured_image": null, "available": true, "price": "19.50", "grams": 367, "compare_at_price": null, "position": 1, "product_id": 6732364546125, "created_at": "2022-04-14T12:09:23-04:00", "updated_at": "2026-09-16T12:24:28-04:00"}, {"id": 39657673130061, "title": "24 oz", "option1": "24 oz", "option2": null, "option3": null, "sku": "E27-1R", "requires_shipping": true, "taxable": true, "featured_image": null, "available": true, "price": "37.50", "grams": 367, "compare_at_price": null, "position": 2, "product_id": 6732364546125, "created_at": "2022-04-14T12:09:23-04:00", "updated_at": "2026-09-16T12:24:28-04:00"}, {"id": 39657673162829, "title": "5 lb", "option1": "5 lb", "option2": null, "option3": null, "sku": "E27-5R", "requires_shipping": true, "taxable": true, "featured_image": null, "available": true, "price": "101.00", "grams": 367, "compare_at_price": null, "position": 3, "product_id": 6732364546125, "created_at": "2022-04-14T12:09:23-04:00", "updated_at": "2026-09-16T12:24:28-04:00"}], "images": [{"id": 33122411315277, "created_at": "2025-06-04T09:57:03-04:00", "position": 1, "updated_at": "2025-06-04T09:57:09-04:00", "product_id": 6732364546125, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0249/4283/7837/files/BigTrouble_Main.jpg?v=1749045429", "width": 2741