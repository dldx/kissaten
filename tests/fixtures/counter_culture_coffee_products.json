{"products": [{"id": 6801620729933, "title": "Idido", "handle": "idido", "body_html": "<p><meta charset=\"utf-8\">The coffees we purchase from the Idido cooperative are simply remarkable. They\u2019re among the highest-quality offerings we buy each year, and come from our longest-running partnership in East Africa. Idido\u2019s members reside in some of Ethiopia's highest-elevation coffee-growing areas. This terroir is renowned for producing highly aromatic, complex coffee flavors. We taste delicate floral notes alongside flavors of melon and citrus.<br></p>\n<p><strong>Pronunciation:\u00a0</strong><meta charset=\"utf-8\"><span>ee-DEE-doe</span></p>", "published_at": "2023-05-25T15:26:48-04:00", "created_at": "2022-09-28T12:13:44-04:00", "updated_at": "2026-09-16T12:24:28-04:00", "vendor": "Counter Culture Coffee - Retail", "product_type": "Coffee", "tags": ["bestseller", "coffee", "color__FF8D6B", "organic", "origin__ethiopia", "origin__single-origin", "roastlevel__light-roast", "single-origin"], "variants": [{"id": 39871623266381, "title": "12 oz", "option1": "12 oz", "option2": null, "option3": null, "sku": "IDIDO-BG", "requires_shipping": true, "taxable": true, "featured_image": null, "available": true, "price": "26.00", "grams": 367, "compare_at_price": null, "position": 1, "product_id": 6801620729933, "created_at": "2022-09-28T12:13:45-04:00", "updated_at": "2026-09-16T12:24:28-04:00"}], "images": [{"id": 33418270539853, "created_at": "2025-07-01T11:24:57-04:00", "position": 1, "updated_at": "2025-07-01T11:24:59-04:00", "product_id": 6801620729933, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0249/4283/7837/files/Idido_2025_PDP_4.png?v=1751383499", "width": 2048, "height": 2048}, {"id": 33418271064141, "created_at": "2025-07-01T11:25:20-04:00", "position": 2, "updated_at": "2025-07-01T11:25:22-04:00", "product_id": 6801620729933, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0249/4283/7837/files/PXL_20221202_091405048-3.jpg?v=1751383522", "width": 2279, "height": 3039}, {"id": 33418271555661, "created_at": "2025-07-01T11:25:37-04:00", "position": 3, "updated_at": "2025-07-01T11:25:40-04:00", "product_id": 6801620729933, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0249/4283/7837/files/PXL_20221202_092349746-3.jpg?v=1751383540", "width": 3024, "height": 4032}, {"id": 33418272407629, "created_at": "2025-07-01T11:25:58-04:00", "position": 4, "updated_at": "2025-07-01T11:26:00-04:00", "product_id": 6801620729933, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0249/4283/7837/files/PXL_20221202_100531794-2.jpg?v=1751383560", "width": 3024, "height": 4032}, {"id": 33418275848269, "created_at": "2025-07-01T11:27:31-04:00", "position": 5, "updated_at": "2025-07-01T11:27:32-04:00", "product_id": 6801620729933, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0249/4283/7837/files/CCC_website_maps_Ethiopia_Yirgacheffe_d12b8e39-2699-4db1-8f55-f12751bdb664.jpg?v=1751383652", "width": 1080, "height": 1080}], "options": [{"name": "Size", "position": 1, "values": ["12 oz"]}]}, {"id": 6870662414413, "title": "Blend Box Subscription", "handle": "blend-box-subscription", "body_html": "<p><span style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\">Want to taste every Counter Culture blend and get free shipping while you do it? Now you can, with our\u00a0Blend Box Subscription! Every two weeks, our Coffee Team selects two different blends for this subscription.</span></p>\n<p><span style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\">The coffees in rotation include Apollo, Big Trouble, Fast Forward, Forty-Six, Hologram, Gradient, and our seasonal blends.</span></p>\n<p><span style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\">Two 12 oz bags total with each shipment.</span></p>\n<p><span style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\">Your credit card will be billed per shipment. Subscriptions begin the business day aft