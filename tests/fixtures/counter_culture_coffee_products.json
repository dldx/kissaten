><span style=\"font-weight: 400;\">Slow down and savor a cup of coffee, simply because it\u2019s delicious. </span><span style=\"font-weight: 400;\">We pay extra attention to our decaf coffee because you deserve </span><span style=\"font-weight: 400;\">a flavorful, full-bodied cup without the caffeine kick.</span> <span style=\"font-weight: 400;\">With notes of molasses and cocoa, Slow Motion is equally delicious as any of our caffeinated coffees.</span></p>\n<p>Decaffeination: Swiss Water Process unless otherwise noted.</p>", "published_at": "2022-03-22T19:51:08-04:00", "created_at": "2022-03-22T11:53:49-04:00", "updated_at": "2026-09-16T12:24:28-04:00", "vendor": "Counter Culture Coffee - Retail", "product_type": "Coffee", "tags": ["coffee", "color__F47F66", "origin__year-round-blend", "roastlevel__medium-roast", "subscription", "year-round"], "variants": [{"id": 39666525208653, "title": "12 oz", "option1": "12 oz", "option2": null, "option3": null, "sku": "D11-BG", "requires_shipping": true, "taxable": true, "featured_image": null, "available": true, "price": "20.00", "grams": 367, "compare_at_price": "17.00", "position": 1, "product_id": 6732315689037, "created_at": "2022-04-27T16:52:14-04:00", "updated_at": "2026-09-16T12:24:28-04:00"}, {"id": 39666527174733, "title": "24 oz", "option1": "24 oz", "option2": null, "option3": null, "sku": "D11-1R", "requires_shipping": true, "taxable": true, "featured_image": null, "available": true, "price": "38.50", "grams": 703, "compare_at_price": "37.00", "position": 2, "product_id": 6732315689037, "created_at": "2022-04-27T16:54:49-04:00", "updated_at": "2026-09-16T12:24:28-04:00"}, {"id": 39666525241421, "title": "5 lb", "option1": "5 lb", "option2": null, "option3": null, "sku": "D11-5R", "requires_shipping": true, "taxable": true, "featured_image": null, "available": true, "price": "103.00", "grams": 2304, "compare_at_price": null, "position": 3, "product_id": 6732315689037, "created_at": "2022-04-27T16:52:14-04:00", "up