lass=\"font_8 wixui-rich-text__text\"\u003e\u003cspan class=\"wixui-rich-text__text\"\u003eProducer: \u003c\/span\u003e\u003cspan class=\"wixui-rich-text__text\"\u003eDr. Enrique Ferrufino and Family.\u003c\/span\u003e\u003c\/p\u003e\n\u003cp class=\"font_8 wixui-rich-text__text\"\u003e\u003cspan class=\"wixui-rich-text__text\"\u003eHarvest Period: December to March 2024\/2025\u003cbr\u003e\u003cbr\u003e\u003cstrong\u003e\u003cmeta charset=\"utf-8\"\u003eGrade:\u003cspan\u003e \u003c\/span\u003eSHG\/EP Rain Forest Alliance Certified\u003cbr\u003e\u003cbr\u003e\u003c\/strong\u003eNOTES : SUGARCANE , MARZIPAN , APPLE \u003c\/span\u003e\u003c\/p\u003e\n\u003cp class=\"font_8 wixui-rich-text__text\"\u003e \u003c\/p\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e","published_at":"2026-05-18T11:44:01+02:00","created_at":"2026-03-26T11:45:47+02:00","updated_at":"2026-09-08T20:34:37+02:00","vendor":"Sorcery Coffee Roasters","product_type":"","tags":[],"variants":[{"id":45101671317538,"title":"500GR","option1":"500GR","option2":null,"option3":null,"sku":null,"requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"379.00","grams":0,"compare_at_price":null,"position":1,"product_id":8348985131042,"created_at":"2026-03-26T11:45:47+02:00","updated_at":"2026-09-08T20:34:37+02:00"},{"id":46534058803234,"title":"1KG","option1":"1KG","option2":null,"option3":null,"sku":null,"requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"560.00","grams":0,"compare_at_price":null,"position":2,"product_id":8348985131042,"created_at":"2026-08-24T08:52:07+02:00","updated_at":"2026-09-08T20:34:37+02:00"}],"images":[],"options":[{"name":"SIZE","position":1,"values":["500GR","1KG"]}]}]}