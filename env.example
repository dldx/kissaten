# Copy this file to .env and add your API keys

# Google Gemini API Key for AI-powered coffee data extraction
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# OpenCage Geocoding API Key for region deduplication and geographical data enrichment
# Get your free key from: https://opencagedata.com/api
# Free tier: 2,500 requests/day, ~1 req/sec
OPENCAGE_API_KEY=your-opencage-api-key-here

# Optional: Set log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Optional: Override default rate limiting (seconds between requests)
# SCRAPER_RATE_LIMIT=2.0

# Optional: AI smart search rate limiting (global, across all users)
# AI_RATE_LIMIT_MAX_REQUESTS=10
# AI_RATE_LIMIT_WINDOW_HOURS=24

# Optional: HTTP/HTTPS proxy for scraper egress only
# Use when scraping from behind a proxy or to route traffic through a specific server.
# Scraper-specific names so other libraries in the same process (logfire,
# geocoding, AI search) never route their traffic through the scraper proxy.
# Legacy HTTP_PROXY/HTTPS_PROXY are still honoured as a deprecated fallback.
# Format: http://proxy-server:port or https://proxy-server:port
# SCRAPER_HTTP_PROXY=http://127.0.0.1:8080
# SCRAPER_HTTPS_PROXY=http://127.0.0.1:8080

# Secret key for generating and verifying signed JWT brew session tokens
# Used by SvelteKit frontend server to sign tokens and FastAPI backend to parse/verify them.
BREW_JWT_SECRET=kissaten_brewing_secret_signature_key_2026_change_me_in_prod

# Cache archive (page cache -> Cloudflare R2)
#
# The scraper host that writes data/cache/roasters/ needs a READ/WRITE R2 token
# so `kissaten cache-sync` can upload with rclone. The API server only reads the
# archive, so give it a SEPARATE READ-ONLY token. Keep the bucket private; no
# public access is required. The cache is append-only and mirrored with
# `rclone copy --immutable` (never sync/delete). See docs/CACHE_ARCHIVE.md.
#
# KISSATEN_CACHE_DIR=data/cache
# KISSATEN_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# KISSATEN_R2_BUCKET=kissaten
# KISSATEN_R2_PREFIX=cache
# KISSATEN_R2_ACCESS_KEY_ID=...
# KISSATEN_R2_SECRET_ACCESS_KEY=...
# KISSATEN_ADMIN_API_TOKEN=...   # shared secret for the admin-only cache viewer API
