    },
    {
      "id": "claim_01a0e1fc12714e88a0c3696ab038130c",
      "statement": "When no roaster_location URL parameter is present and apply_location_defaults is not 'false', +page.ts falls back to the user's saved roaster location preferences from parentData.userDefaults.roasterLocations. The searchStore.updateURL() writes apply_location_defaults=false when the user has cleared location filters, preventing the defaults from silently re-applying on subsequent navigations.",
      "evidence": [
        {
          "resource": "repo://frontend/src/lib/stores/search.ts#L120-L129",
          "version": "repo-lines-v1:sha256:147bab9048df0847fc6d459c5086f2d9a5cea3de282490ee07933d6172e94358:"
