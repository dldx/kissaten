    {
      "id": "claim_b9b6009f10294396abf07d2bdca6e35c",
      "statement": "The searchStore (a Svelte writable store created by createSearchStore()) is the single client-side source of truth after hydration. It owns all filter fields, builds SearchParams via buildSearchParams() (converting string fields to typed values, appending convert_to_currency), calls api.search(), and exposes performNewSearch(), loadMore(), performSmartSearch(), performImageSearch(), and clearFilters(). loadMore() includes a duplicate-id guard that deduplicates incoming beans by id to prevent Svelte {#each} reconciliation RangeErrors from non-deterministic pagination on ties.",
      "evidence": [
        {
          "resource": "repo://frontend/src/lib/stores/search.ts#L181-L273",
          "version": "repo-lines-v1:sha256:7c9ef7f865c31ff01190079483d89caedd585a0dce8829f63f79b41097a1ef76:"
        },
