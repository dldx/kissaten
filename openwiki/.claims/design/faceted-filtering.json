  "claims": [
    {
      "id": "claim_15f41eea995c4df89497c2e589f716c6",
      "statement": "The search page state is fully URL-driven: +page.ts parses all filter parameters from url.searchParams on both server and client, calls api.search() with SvelteKit's injected fetch for SSR, and returns the first page of results plus the parsed searchParams so the store can rehydrate. The searchStore then manages client-side updates via performNewSearch(), which calls updateURL() to write the current state back to the URL via goto() with replaceState and noScroll, debounced at 100ms.",
      "evidence": [
        {
          "resource": "repo://frontend/src/lib/stores/search.ts#L111-L179",
          "version": "repo-lines-v1:sha256:c120a07ff634ac5991fb56e625eb3ff01fc4f0af339c5de4784ff6434d1ddc3b:"
        },
        {
          "resource": "repo://frontend/src/routes/(main)/search/%2Bpage.svelte#L20-L62",
          "version": "repo-lines-v1:sha256:d13d6f6a1bf7b31ef8191f582fe64c835d4fb3537216947ff343615ca86601cb:"
        },
        {
