    {
      "id": "claim_75f18647e5044be5b0d8c8049690ef01",
      "statement": "Sync supports three modes: 'normal' (incremental push+pull via since cursors), 'verify-then-fix' (run verifySyncConsistency then force-full the drifting tables), and 'force-full' (ignore cursors and re-fetch everything), chosen via the RunGlobalSyncOptions.mode field.",
      "evidence": [
        {
          "resource": "repo://frontend/src/lib/sync/syncManager.svelte.ts#L8-L52",
          "version": "repo-lines-v1:sha256:9aa19cfda6564ab6aba11f267fa4b413314df70d83d9ea138c12ca6aa7126432:"
        }
      ]
    },
    {
      "id": "claim_f7964b42a68849d7bfa18744c1eb81b2",
      "statement": "verifySyncConsistency compares local vs remote per-table counts and SHA-256 digests over (syncId, updatedAt) pairs to detect count_mismatch or digest_mismatch, excluding soft-deleted and locally-dirty (no syncedAt or updatedAt > syncedAt) records and brew recipes with isSaved !== true.",
      "evidence": [
        {
          "resource": "repo://frontend/src/lib/sync/verifySync.ts#L1-L50",
          "version": "repo-lines-v1:sha256:a98efe53b95ad5126fa99b02c2a31541501a2266743d8acd89ed7ea5dc963eb5:"
        }
      ]
    },
    {
      "id": "claim_24af0d66337b42bcb5cf6825629e42e9",
      "statement": "Sync is offline-first: each table pushes records with no syncedAt or updatedAt > syncedAt and stamps syncedAt on success, so un-pushed local edits retry on the next cycle; guest-to-user claiming assigns unowned local records to the logged-in user on first sync.",
