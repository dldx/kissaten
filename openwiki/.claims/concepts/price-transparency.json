    {
      "id": "claim_1aa78593c8664bf9b566b9db89775322",
      "statement": "The bean detail endpoint (GET /v1/beans/{roaster_slug}/{bean_slug}) builds APIBean origin objects that inherit the transparency fields (fob_price, farm_gate_price, price_paid_to_producer, price_currency, importer_name) from the Bean base class, surfacing them in the serialized response; retail price conversion on this endpoint operates on the bean-level price, price_options, and legacy price_paid_for_green_coffee but not on the per-origin transparency prices.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/api/main.py#L4722-L4790",
          "version": "repo-lines-v1:sha256:450af856a73958a3497a39184761cfadba3d9f658a699502176ef806af348139:"
