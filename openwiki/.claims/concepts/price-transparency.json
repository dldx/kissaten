  "claims": [
    {
      "id": "claim_42091145a22a435a896152987f8d4954",
      "statement": "The cost transparency fields (fob_price, farm_gate_price, price_paid_to_producer, price_currency, importer_name) are defined on the Bean model — the per-origin element of CoffeeBean.origins[] — rather than at the bean (product) level, so that each origin/lot in a blend can carry independent pricing.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/schemas/coffee_bean.py#L252-L280",
          "version": "repo-lines-v1:sha256:c20b9e9c92efa21cc2f47adea765033df8de94acc0801abe6ea74825695965ea:"
        },
        {
          "resource": "repo://src/kissaten/schemas/coffee_bean.py#L382-L392",
          "version": "repo-lines-v1:sha256:550743c773138d062f80feb2f08f4fd601ee02b42db900d3c107ab3a42d86899:"
        }
      ]
    },
    {
      "id": "claim_7433e0dd42c74ffc979940b5d9a6c66b",
      "statement": "The three transparency prices are per-kg in USD: farm_gate_price is the price paid at the farm before transport and processing, fob_price is the Free On Board price at the port of export (includes transport and processing), and price_paid_to_producer captures direct payments including quality premiums and direct-trade arrangements.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/schemas/coffee_bean.py#L253-L269",
          "version": "repo-lines-v1:sha256:43927d0870b88a2ded56ab89491828d11a665252ebcda8d7fd76f00619f0fda6:"
        }
      ]
    },
    {
      "id": "claim_bea214e981244896abc227a0f260c65c",
      "statement": "price_currency is a per-origin 3-letter currency code for the transparency prices (defaults to USD when prices are mentioned), distinct from the bean-level currency field used for retail pricing; importer_name is the importer or trading company name (1-200 characters).",
      "evidence": [
        {
          "resource": "repo://src/kissaten/ai/extractor.py#L110-L113",
          "version": "repo-lines-v1:sha256:b4b084f32b76a8e49d33e082fb0a54825a42a89d3eafe21a0d920f4b89297dc3:"
        },
        {
          "resource": "repo://src/kissaten/schemas/coffee_bean.py#L270-L280",
          "version": "repo-lines-v1:sha256:4d010c69756e44fc9fd346fd20aee0672e1e2a608c789577fe2899478956af39:"
        }
      ]
    },
    {
      "id": "claim_c55c2e0d8aee45f3a59e52ecce54090f",
      "statement": "The fob_price, farm_gate_price, and price_paid_to_producer fields are declared with gt=0 and share a single validator that rejects values below $0.50 or above $300 USD per kg, raising 'Price per kg must be between $0.50 and $300 USD'.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/schemas/coffee_bean.py#L253-L269",
          "version": "repo-lines-v1:sha256:43927d0870b88a2ded56ab89491828d11a665252ebcda8d7fd76f00619f0fda6:"
