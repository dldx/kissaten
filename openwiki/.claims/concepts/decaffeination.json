  "claims": [
    {
      "id": "claim_c137926c85244deda7ac91e428ab776d",
      "statement": "The authoritative CoffeeBean schema models decaffeination as a simple boolean, is_decaf, defaulting to False, rather than capturing the specific decaffeination method (Swiss Water, CO2, ethyl acetate, methylene chloride).",
      "evidence": [
        {
          "resource": "repo://src/kissaten/schemas/coffee_bean.py#L407-L407",
          "version": "repo-lines-v1:sha256:c91eff28390af15992ffb51be832f2780c1c0c0c593ef26151bc69fb4ccdb5ff:"
        }
      ]
    },
    {
      "id": "claim_82bfcc075a054dab94b197b8513d2964",
      "statement": "Lenient and API schemas relax is_decaf to bool | None: CoffeeBeanDiffUpdate allows None to mean 'no change', CoffeeBeanOptional makes every field optional, and APICoffeeBean explicitly overrides is_decaf to bool | None for backward compatibility with existing data that may carry NULL.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/schemas/api_models.py#L56-L58",
          "version": "repo-lines-v1:sha256:8eb32dbe72766f1c53844c5a078fa5ca7d4ec3aa243abf842966d6c7db06df50:"
