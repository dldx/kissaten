    {
      "id": "claim_5bf0ac6e6ff64f39bfb6cec5c3d2dd77",
      "statement": "is_decaf is always applied as a hard WHERE filter (cb.is_decaf = ?), never as a soft relevance-scoring component, because showing a bean with the wrong caffeine status is never useful — this is an accessibility invariant. is_tasting_kit mirrors this hard-filter behaviour.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/api/main.py#L584-L592",
          "version": "repo-lines-v1:sha256:09bcba2c206a7798bcff3c8402e39ce45dd2c3731599bd279b98cc105d79fbc3:"
        }
      ]
    },
    {
      "id": "claim_783a0208004d4a2b83d6138f7747eadc",
      "statement": "The FilterParams internal model carries is_decaf as bool | None (default None), and build_coffee_bean_filters is reused across search, recommendations, and discovery so the hard-filter behaviour is consistent across all bean-listing paths.",
