        }
      ]
    },
    {
      "id": "claim_bbc9b05108954927a8ed1c16a0667a07",
      "statement": "The coffee_beans database table declares is_decaf as a nullable BOOLEAN column, and the load/insert path normalises missing values with COALESCE(is_decaf, false) so that beans with NULL decaf status are treated as regular coffee rather than dropped.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/api/db.py#L2240-L2240",
