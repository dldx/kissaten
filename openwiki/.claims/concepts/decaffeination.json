    {
      "id": "claim_90ec7e1c976c48d4bd5f40815064b95e",
      "statement": "The /v1/search and related list endpoints expose is_decaf as an optional bool | None Query parameter; None means no constraint, True returns only decaf, False returns only caffeinated beans.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/api/main.py#L1909-L1909",
          "version": "repo-lines-v1:sha256:1e0a4cd8e411a04a0a266a9147d02c8207f757d3835c8cb7e59bef9272f8da99:"
