    {
      "id": "claim_c265848ba8ff4032bc2125b837c1c41f",
      "statement": "FilterTags.svelte surfaces the active decaf constraint as a removable chip — 'Decaf only' (ban icon) when true, 'Caffeinated only' (zap icon) when false — so the user can see and clear the current caffeine constraint.",
