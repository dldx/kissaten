    {
      "id": "claim_2446530241574d34bd21d15de19e68b9",
      "statement": "Roast level is treated as an ordered 0–5 scale (Extra-Light→0 ... Dark→5) for closeness scoring in build_coffee_bean_filters: an exact match scores 1.0, one level apart 0.5, two levels apart 0.2, weighted by the configurable roast_level weight, which powers bean similarity recommendations.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/api/main.py#L225-L237",
          "version": "repo-lines-v1:sha256:bf9f04c5f97526eb0b0072d7393e5b22d9cdba77ad04c2396d9e82acd280a7ac:"
