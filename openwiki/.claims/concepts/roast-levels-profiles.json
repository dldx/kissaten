    },
    {
      "id": "claim_42c6944560274c8fb378e35205339446",
      "statement": "'Omni' means a single roast of the same beans suitable for both espresso and filter, while 'Both' means the roaster offers separate espresso and filter roasts as distinct options on the same product page, as stated in the roast_profile field description.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/schemas/coffee_bean.py#L100-L103",
          "version": "repo-lines-v1:sha256:f85af0684df4189ae5f49a2d0db7130cf4cd9df5c146cf9e993683e03b0f003a:"
        }
