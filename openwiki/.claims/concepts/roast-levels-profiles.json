          "version": "repo-lines-v1:sha256:d72a0ee34d6de4e2cc112a501e92b33f0aac086e310d2d684475a1e2c5270b9e:"
        }
      ]
    },
    {
      "id": "claim_7879be9817554b079c628644daf0b26a",
      "statement": "When the roast_level filter contains wildcard or boolean operators (|, &, !, *, ?, parentheses) it falls back to the generic boolean ILIKE text filter against cb.roast_level instead of the closeness scale.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/api/main.py#L515-L518",
