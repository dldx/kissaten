  "claims": [
    {
      "id": "claim_13233e9cfad344dca38d764ca93ab83d",
      "statement": "Roast level is modelled as a six-member RoastLevel Enum (Extra-Light, Light, Medium-Light, Medium, Medium-Dark, Dark) whose canonical string values are used across scraping, storage, and the UI.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/schemas/coffee_bean.py#L53-L61",
          "version": "repo-lines-v1:sha256:85b59db492769c410fa977087129fa71173914d369a93ab7398ffa90f273be43:"
        }
      ]
    },
    {
      "id": "claim_434103b9da124ff8ab3b5249d41da84e",
      "statement": "Roast profile is modelled as a Literal['Espresso','Filter','Omni','Both'] (not an Enum) on CoffeeBean, CoffeeBeanDiffUpdate, and the v1 API bean model, encoding brewing intent and how 'both' is presented rather than a standardised industry scale.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/schemas/coffee_bean.py#L100-L103",
          "version": "repo-lines-v1:sha256:f85af0684df4189ae5f49a2d0db7130cf4cd9df5c146cf9e993683e03b0f003a:"
        },
        {
