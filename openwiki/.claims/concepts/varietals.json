    {
      "id": "claim_7e4b2c285119481c96ccceb83e1bb4d8",
      "statement": "The origins ETL populates variety_canonical from the mappings and derives variety_canonical_slugs by applying normalize_varietal_name to each canonical name.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/api/db.py#L2352-L2362",
