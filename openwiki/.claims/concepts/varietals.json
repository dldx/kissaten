    },
    {
      "id": "claim_22ba7379d7a646cb97340af983f48f8e",
      "statement": "The varietal_mappings.json loader in db.py keys the in-memory original_name→canonical_names dict case-insensitively and joins origins to mappings with LOWER(COALESCE(origin.variety,'')) = LOWER(vm.original_name), so case variants like GEISHA and Geisha resolve identically; unmatched varieties fall back to a single-element [variety] canonical array.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/api/db.py#L1668-L1673",
          "version": "repo-lines-v1:sha256:7036424a883aec5d5eef08e2ac835235c1f9a4227b8d8635bfb01a0bd6bb6c69:"
