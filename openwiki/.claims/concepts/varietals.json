    {
      "id": "claim_3509fac27a92413a86af514ea1fdf91f",
      "statement": "categorize_varietal in the API classifies a canonical varietal name into one of nine family slugs (typica, bourbon, heirloom, geisha, sl_varieties, hybrid, large_bean, arabica_other, other) via keyword matching against the varietal name, with SL varieties also matched by the regex sl\\d+.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/api/main.py#L1243-L1331",
          "version": "repo-lines-v1:sha256:eabfb85ec8bba289fd3243113897b4661acfeb1f67adeaa3906a054edb779485:"
