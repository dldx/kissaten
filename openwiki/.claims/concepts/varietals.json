    {
      "id": "claim_a093e8b1429c43ca85e382fdbb66c0fc",
      "statement": "The categorisation pipeline is incremental: already-mapped original_name values are skipped, mappings with confidence below 0.6 are dropped to force retry, failed batches fall back to self-mappings at confidence 0.5, and conflict detection ignores both compound mappings and pure case/punctuation variants so only genuinely suspicious merges are flagged.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/ai/varietal_categorizer.py#L611-L649",
          "version": "repo-lines-v1:sha256:0a5b02fbc9209285aa020113c487144015a447e75dd773874a771a468a109cf0:"
        },
