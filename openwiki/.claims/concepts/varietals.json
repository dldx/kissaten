    {
      "id": "claim_a56be7683377414c85d058ba7062ec26",
      "statement": "normalize_varietal_name produces URL-friendly varietal slugs by NFKD-decomposing accents to ASCII, lowercasing, stripping non-alphanumeric/space/hyphen characters, and collapsing spaces/hyphens to a single hyphen (e.g. Gesha→gesha, Catuaí→catuai, SL 28→sl-28).",
      "evidence": [
        {
          "resource": "repo://src/kissaten/api/db.py#L292-L302",
          "version": "repo-lines-v1:sha256:38abee95cf4ff7898a49014248e85ef83219312d29a50e958847f74f0955302b:"
        }
