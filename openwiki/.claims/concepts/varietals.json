  "claims": [
    {
      "id": "claim_9c55e237e35042a782fc81c4d2750611",
      "statement": "Kissaten stores the roaster's verbatim varietal text in the free-text, optional, 100-char `variety` field on the `Bean` origin model (and the brew-assistant schema), and defers canonicalisation to an offline AI categoriser rather than validating against a varietal list at scrape time.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/api/brew_assistant.py#L52-L52",
          "version": "repo-lines-v1:sha256:5b452c83bd35bba5ee3af3bfb45078acb086fe4c56c7b1e37a0f0fbbef1b6c13:"
        },
        {
          "resource": "repo://src/kissaten/schemas/coffee_bean.py#L242-L247",
          "version": "repo-lines-v1:sha256:d82ea96198f798afc625226f2f5928895f4b0ba4f5c981fab449ad726a0bf7a8:"
        }
      ]
    },
    {
      "id": "claim_d7e940d212cf4088a35d2a76677bd00b",
      "statement": "The `VarietalCategorizer` canonicalises raw `variety` strings into `VarietalMapping` records persisted in `varietal_mappings.json`, each carrying original_name, canonical_names (one or many), confidence (0-1), is_compound, and separator.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/ai/varietal_categorizer.py#L40-L53",
          "version": "repo-lines-v1:sha256:deda380489d2d225899a6f822939edadba13389007a5a5dd039d4174a19c2ad7:"
        },
        {
          "resource": "repo://src/kissaten/database/varietal_mappings.json#L1-L10",
          "version": "repo-lines-v1:sha256:68e4be489b85b6196ac4204e486d6eb7cee82ec024ec460500b54beba1f96823:"
        }
      ]
    },
    {
      "id": "claim_8416ee6a17fc4c838e813707b978dcaa",
      "statement": "Compound varietal splitting is enforced by two validators: `clean_separator` strips alphanumeric characters from the separator field, and the `ensure_compound_split` model_validator repairs the common LLM failure of returning a single canonical entry that still contains the separator by splitting it and setting is_compound=true.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/ai/varietal_categorizer.py#L65-L97",
          "version": "repo-lines-v1:sha256:cd06e0ac1a936a0e4973bba739f7d827d688a4fc4cd5cbd8fe6d94c019575f54:"
        }
      ]
    },
    {
      "id": "claim_827cbe3258d0455faf4a37885bd1d947",
      "statement": "Generic blend terms (Mixed, Varios, Variadades, Local Landraces) are mapped to the single canonical `Field Blend` and are deliberately not split, while distinct specific varieties joined by separators (, & / +) are split into multiple canonical names with is_compound=true.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/ai/varietal_categorizer.py#L291-L309",
          "version": "repo-lines-v1:sha256:75386931c08fa17b43f27379a83c36f920c3187a816759d500314ae1320f7cc2:"
        }
      ]
    },
    {
      "id": "claim_f55cbc1274244a78a39c5421de756b3e",
      "statement": "The categorisation agent preserves colour information (Red Caturra ≠ Yellow Caturra) and respects distinct technical codes (SL28 ≠ SL34, 74110 ≠ 74112) and distinct hybrids vs parents (Pacamara ≠ Pacas), never merging them.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/ai/varietal_categorizer.py#L329-L364",
          "version": "repo-lines-v1:sha256:c2d0c5be457e5eb2f27dccfc536889a44ed1a0a601fef81bdcd44ce4fbb5d6a3:"
        }
      ]
    },
    {
      "id": "claim_dff32874915f45f7a9312bfa667d2765",
      "statement": "World Coffee Research reference data in `coffee_varietals.json` is the ground truth for canonical names; each entry has name, description, link (WCR variety page URL), and species (arabica), and the categoriser loads it into a case-insensitive lookup keyed on name and alternate_names that is injected into the agent system prompt.",
      "evidence": [
        {
          "resource": "repo://src/kissaten/ai/varietal_categorizer.py#L242-L269",
          "version": "repo-lines-v1:sha256:4740ab75b464848cd1899e3030b2449ed12f211518bf11a5aad04923cdfc2031:"
